DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_bot_client_id_here
SQLITECLOUD_URI=sqlitecloud://your-host.sqlite.cloud:8860/your-db?apikey=your-apikey

# Discord Webhook Log (tùy chọn - hiển thị log lên Discord)
DISCORD_LOG_WEBHOOK=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
